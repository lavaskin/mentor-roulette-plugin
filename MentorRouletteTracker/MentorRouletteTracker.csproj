<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Dalamud.NET.Sdk/15.0.0">

  <PropertyGroup>
    <Version>1.4.0</Version>
    <Author>lavaskin</Author>
    <Name>Mentor Roulette Tracker</Name>
    <Punchline>Logs your Mentor Roulette runs to Mentor Roulette Tracker.</Punchline>
    <Description>Keeps track of your Mentor Roulette runs, with their wipes, the party's deaths and your time, and logs them to your account on Mentor Roulette Tracker (mentorroulette.com).</Description>
    <RepoUrl>https://github.com/lavaskin/mentor-roulette-plugin</RepoUrl>
    <Tags>mentor;roulette;duty;tracker;stats</Tags>
    <IconUrl>https://raw.githubusercontent.com/lavaskin/mentor-roulette-plugin/main/images/icon.png</IconUrl>
    <AcceptsFeedback>false</AcceptsFeedback>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\MentorRouletteTracker.Core\MentorRouletteTracker.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\images\icon.png" Link="images\icon.png" CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

</Project>
